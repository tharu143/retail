{
  "name": "kyle-retail",
  "private": true,
  "version": "1.1.15",
  "description": "Offline-First Retail POS Application",
  "author": "Kyle Tharun Kumar <dev@kylesolutions.in>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "clean": "rimraf release",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/main.cjs\"",
    "build:ui": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder --win --x64 -c.extraMetadata.main=electron/main.cjs -c.directories.output=release"
  },
  "build": {
    "appId": "com.kylesolutions.kyle_retail",
    "productName": "KyleRetailPOS",
    "executableName": "kyle-retail",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.9.2",
    "@tailwindcss/vite": "^4.1.16",
    "@zxing/library": "^0.21.3",
    "axios": "^1.13.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.3.0",
    "dispatch": "^1.0.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.548.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-responsive-carousel": "^3.2.23",
    "react-router-dom": "^7.9.4",
    "redux-persist": "^6.0.0",
    "sqlite3": "^5.1.7",
    "sweetalert2": "^11.26.21",
    "tailwindcss": "^4.1.16",
    "uuid": "^13.0.0",
    "wait-on": "^9.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "rimraf": "^5.0.0",
    "vite": "^7.1.7"
  }
}